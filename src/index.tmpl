      <div id="references">
        <h2>References</h2>

        <script type="text/javascript">
          const api_url = '/recommendations.json';

          // Defining async function
          async function getapi(url) {
            
            // Storing response
            const response = await fetch(url);
            
            // Storing data in form of JSON
            var data = await response.json();
            console.log(data);
            if (response) {
                hideloader();
            }
            show(data);
          }
          // Calling that async function
          getapi(api_url);

          // Function to hide the loader
          function hideloader() {
            document.getElementById('loading').style.display = 'none';
          }
          // Function to define innerHTML for HTML table
          function show(data) {
            let tab = ``;
            
            // Loop through each recommendation in the data object
            for (let i = 0; i < data.recommendations.length; i++) {
              const r = data.recommendations[i];

              // Construct an HTML string for each recommendation and append it to the 'tab' variable
              tab += `<li id="recommend-${i}"> 
                <p style='margin-right:30px'><b><a href="javascript:void(0)" onclick="document.getElementById('recommend-${i}-details').style.display='block';">${r.firstName} ${r.lastName}</a> - ${r.company}, ${r.relation}</b></p>
                <div id="recommend-${i}-details" class="white_content">
                  ${r.quote}<br />
                  <br />
                  <a href="${r.linkedinUrl}" target="_blank">${r.firstName} ${r.lastName}</a><br />
                  <br />
                  <a href="javascript:void(0)" onclick="document.getElementById('recommend-${i}-details').style.display='none';">Close</a>
                </div>
              </li>`;
            }
            // Update the webpage with the list of recommendations
            document.getElementById("recommend").innerHTML = tab;
          }
        </script>

